# ============================================================================
# Mastermind Bot - Sample Environment Configuration (Copy to env.txt)
# Supports Isolated Dual Main Bot Architecture:
#   1. Public Main Bot  -> Deployed on Render service `mastermind` (branch: `main`)
#   2. Testing Main Bot -> Deployed on separate Render service (branch: `test`)
#      with its own isolated Storage Group, Posting Channel, Logger Group,
#      Index Logs Channel, Request Logs Channel, and Backup Channel.
# ============================================================================

# --- Deployment Mode & Bot Tokens ---
# BOT_MODE: "public" (default on `main` branch) or "testing" (auto-detected on `test` branch)
BOT_MODE=public
BOT_NAME=Mastermind
TELEGRAM_BOT_TOKEN=1234567890:AAF_SAMPLE_MAIN_BOT_TOKEN_REPLACE_ME
PUBLIC_BOT_TOKEN=1234567890:AAF_SAMPLE_PUBLIC_MAIN_BOT_TOKEN_REPLACE_ME
TESTING_BOT_TOKEN=1234567899:AAF_SAMPLE_TESTING_MAIN_BOT_TOKEN_REPLACE_ME

# --- Helper Bots ---
HELPER_BOT_TOKENS=1234567891:AAF_SAMPLE_HELPER_BOT_1_TOKEN,1234567892:AAF_SAMPLE_HELPER_BOT_2_TOKEN
PUBLIC_HELPER_BOT_TOKENS=
TESTING_HELPER_BOT_TOKENS=
HELPER_POLLING_ENABLED=true

# --- GOD & Admins ---
GOD_ID=123456789
OWNER_ID=123456789
ADMIN_IDS=123456789,987654321

# --- Public Main Bot Groups & Channels (or active service defaults) ---
STORAGE_GROUP_ID=-1001111111111
POSTING_CHANNEL_ID=-1002222222222
LOGGER_GROUP_ID=-1003333333333
INDEX_CHANNEL_ID=-1004444444444
REQUEST_CHANNEL_ID=-1005555555555
SUPPORT_CHAT_ID=-1006666666666
SEARCH_GROUP_ID=-1007777777777
BACKUP_CHAT_ID=-1004444444444
BACKUP_FILENAME=mastermind_backup.zip

# --- Testing Main Bot Isolated Groups & Channels (used when BOT_MODE=testing) ---
TESTING_STORAGE_GROUP_ID=-1009999999991
TESTING_POSTING_CHANNEL_ID=-1009999999992
TESTING_LOGGER_GROUP_ID=-1009999999993
TESTING_INDEX_CHANNEL_ID=-1009999999994
TESTING_REQUEST_CHANNEL_ID=-1009999999995
TESTING_SUPPORT_CHAT_ID=-1009999999996
TESTING_SEARCH_GROUP_ID=-1009999999997
TESTING_BACKUP_CHAT_ID=-1009999999994
TESTING_BACKUP_FILENAME=mastermind_test_backup.zip

# --- Logger Forum Topic IDs (Public & Testing) ---
GENERAL_TOPIC_ID=1
USER_LOG_TOPIC_ID=2
INDEX_LOG_TOPIC_ID=20
GROUP_LOG_TOPIC_ID=23
CHANNEL_LOG_TOPIC_ID=26
REQUEST_LOG_TOPIC_ID=30
ERROR_LOG_TOPIC_ID=33

# --- Delivery & Backup Timers ---
AUTO_DELETE_SECONDS=300
BACKUP_INTERVAL_SECONDS=300

# --- Supported Formats ---
SUPPORTED_EBOOK_EXTENSIONS=.epub,.pdf,.azw,.azw3,.mobi,.cbz,.cbr
SUPPORTED_AUDIOBOOK_EXTENSIONS=.mp3,.m4b,.aax,.aa,.flac,.wav

# --- Quotas & Referrals ---
ITEMS_PER_PAGE=10
DEFAULT_SEARCH_QUOTA=10
DEFAULT_REQUEST_QUOTA=10
PROMOTER_QUOTA_DEFAULT=20
VOLUNTEER_QUOTA_DEFAULT=30
MODERATOR_QUOTA_DEFAULT=40
REFERRAL_SEARCH_BONUS=10
REFERRAL_REQUEST_BONUS=10

# --- Indexing & Runtime ---
MAX_INDEX_BATCH=10
INDEX_SLEEP_SECONDS=10
MAX_LOG_LINES=1000
PORT=8080
COMMUNITY_LINK=https://t.me/sample_mastermind_community
