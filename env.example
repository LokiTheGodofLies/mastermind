# ============================================================================
# Mastermind Bot - Sample Environment Configuration (Copy to env.txt)
# ============================================================================

# --- Bot Tokens ---
TELEGRAM_BOT_TOKEN=1234567890:AAF_SAMPLE_MAIN_BOT_TOKEN_REPLACE_ME
HELPER_BOT_TOKENS=1234567891:AAF_SAMPLE_HELPER_BOT_1_TOKEN,1234567892:AAF_SAMPLE_HELPER_BOT_2_TOKEN
BOT_NAME=Mastermind

# --- Owner & Admins ---
OWNER_ID=123456789
ADMIN_IDS=123456789,987654321

# --- Group & Channel IDs ---
STORAGE_GROUP_ID=-1001111111111
POSTING_CHANNEL_ID=-1002222222222
LOGGER_GROUP_ID=-1003333333333
INDEX_CHANNEL_ID=-1004444444444
REQUEST_CHANNEL_ID=-1005555555555
SUPPORT_CHAT_ID=-1006666666666
SEARCH_GROUP_ID=-1007777777777
BACKUP_CHAT_ID=-1003333333333

# --- Logger Forum Topic IDs ---
GENERAL_TOPIC_ID=1
USER_LOG_TOPIC_ID=2
INDEX_LOG_TOPIC_ID=3
GROUP_LOG_TOPIC_ID=4
CHANNEL_LOG_TOPIC_ID=5
REQUEST_LOG_TOPIC_ID=6
ERROR_LOG_TOPIC_ID=7

# --- Delivery & Backup Timers ---
AUTO_DELETE_SECONDS=300
BACKUP_INTERVAL_SECONDS=300

# --- Supported Formats ---
SUPPORTED_EBOOK_EXTENSIONS=.epub,.pdf,.azw,.azw3,.mobi,.cbz,.cbr
SUPPORTED_AUDIOBOOK_EXTENSIONS=.mp3,.m4b,.aax,.aa,.flac,.wav

# --- Quotas & Referrals ---
ITEMS_PER_PAGE=10
DEFAULT_SEARCH_QUOTA=10
DEFAULT_REQUEST_QUOTA=10
PROMOTER_QUOTA_DEFAULT=20
VOLUNTEER_QUOTA_DEFAULT=30
MODERATOR_QUOTA_DEFAULT=40
REFERRAL_SEARCH_BONUS=10
REFERRAL_REQUEST_BONUS=10

# --- Indexing & Runtime ---
MAX_INDEX_BATCH=10
INDEX_SLEEP_SECONDS=10
MAX_LOG_LINES=1000
PORT=8080
COMMUNITY_LINK=https://t.me/sample_mastermind_community
