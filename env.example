# ============================================================================
# Mastermind Bot - Sample Environment Configuration (Copy to env.txt)
# Supports Isolated Dual Main Bot Architecture:
#   1. Public Main Bot  -> Deployed on Render service `mastermind` (branch: `main`)
#   2. Testing Main Bot -> Deployed on separate Render service (branch: `test`)
#      with its own isolated Storage Group, Posting Channel, Logger Group,
#      Index Logs Channel, Request Logs Channel, and Backup Channel.
# ============================================================================

# --- Deployment Mode & Bot Tokens ---
# BOT_MODE: "public" (default on `main` branch) or "testing" (auto-detected on `test` branch)
BOT_MODE=public

# --- Shared (same on both services) ---
# REQUIRED: the bot refuses to start without CREATOR_ID
CREATOR_ID=123456789
CREATOR_USERNAME=your_username
ADMIN_IDS=

# --- PUBLIC Main Bot (read ONLY by the PUBLIC service) ---
PUBLIC_BOT_NAME=Mastermind
PUBLIC_BOT_TOKEN=1234567890:AAF_SAMPLE_PUBLIC_MAIN_BOT_TOKEN
PUBLIC_HELPER_BOT_TOKENS=1234567891:AAF_SAMPLE_PUBLIC_HELPER_BOT_TOKEN
PUBLIC_HELPER_POLLING_ENABLED=true
PUBLIC_STORAGE_GROUP_ID=-1001234567890
PUBLIC_POSTING_CHANNEL_ID=-1001234567890
PUBLIC_LOGGER_GROUP_ID=-1001234567890
PUBLIC_INDEX_CHANNEL_ID=-1001234567890
PUBLIC_REQUEST_CHANNEL_ID=-1001234567890
PUBLIC_SUPPORT_CHAT_ID=-1001234567890
PUBLIC_SEARCH_TOPIC_ID=4488
PUBLIC_BACKUP_TOPIC_ID=4
PUBLIC_BACKUP_FILENAME=mastermind_backup.zip
PUBLIC_GENERAL_TOPIC_ID=1
PUBLIC_USER_LOG_TOPIC_ID=2
PUBLIC_INDEX_LOG_TOPIC_ID=20
PUBLIC_GROUP_LOG_TOPIC_ID=23
PUBLIC_CHANNEL_LOG_TOPIC_ID=26
PUBLIC_REQUEST_LOG_TOPIC_ID=30
PUBLIC_ERROR_LOG_TOPIC_ID=33

# --- TESTING Main Bot (read ONLY by the TESTING service) ---
TESTING_BOT_NAME=Mastermind Test
TESTING_BOT_TOKEN=1234567890:AAF_SAMPLE_TESTING_MAIN_BOT_TOKEN
TESTING_HELPER_BOT_TOKENS=1234567891:AAF_SAMPLE_TESTING_HELPER_BOT_TOKEN
TESTING_HELPER_POLLING_ENABLED=true
TESTING_STORAGE_GROUP_ID=-1001234567890
TESTING_POSTING_CHANNEL_ID=-1001234567890
TESTING_LOGGER_GROUP_ID=-1001234567890
TESTING_INDEX_CHANNEL_ID=-1001234567890
TESTING_REQUEST_CHANNEL_ID=-1001234567890
TESTING_SUPPORT_CHAT_ID=-1001234567890
TESTING_SEARCH_TOPIC_ID=579
TESTING_BACKUP_TOPIC_ID=583
TESTING_BACKUP_FILENAME=mastermind_test_backup.zip
TESTING_GENERAL_TOPIC_ID=1
TESTING_USER_LOG_TOPIC_ID=2
TESTING_INDEX_LOG_TOPIC_ID=20
TESTING_GROUP_LOG_TOPIC_ID=23
TESTING_CHANNEL_LOG_TOPIC_ID=26
TESTING_REQUEST_LOG_TOPIC_ID=30
TESTING_ERROR_LOG_TOPIC_ID=33

# --- Delivery & Backup Timers ---
AUTO_DELETE_SECONDS=300
BACKUP_INTERVAL_SECONDS=300

# --- Supported Formats ---
SUPPORTED_EBOOK_EXTENSIONS=.epub,.pdf,.azw,.azw3,.mobi,.cbz,.cbr
SUPPORTED_AUDIOBOOK_EXTENSIONS=.mp3,.m4b,.aax,.aa,.flac,.wav

# --- Quotas & Referrals ---
ITEMS_PER_PAGE=10
DEFAULT_SEARCH_QUOTA=10
DEFAULT_REQUEST_QUOTA=10
PROMOTER_QUOTA_DEFAULT=20
VOLUNTEER_QUOTA_DEFAULT=30
MODERATOR_QUOTA_DEFAULT=40
REFERRAL_SEARCH_BONUS=10
REFERRAL_REQUEST_BONUS=10

# --- Indexing & Runtime ---
MAX_INDEX_BATCH=10
INDEX_SLEEP_SECONDS=10
MAX_LOG_LINES=1000
PORT=8080
COMMUNITY_LINK=https://t.me/sample_mastermind_community

# Small caps text (default on). Set SMALL_CAPS=0 to disable.
SMALL_CAPS=1
# Use the true small-cap "s" glyph (needs newer fonts). Default 0 = safest for old phones.
SMALL_CAPS_EXTENDED=0
