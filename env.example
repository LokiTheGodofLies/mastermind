# Copy to env.txt (local) or set these in Render -> Environment. Never commit real values.

# --- Required -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
ADMIN_IDS=            # comma-separated Telegram user IDs of the owners, e.g. 111111111,222222222

# --- Chats --------------------------------------------------------------------------------
STORAGE_CHANNEL_ID=   # where indexed files live
POSTING_CHANNEL_ID=   # temporary delivery channel (files auto-delete)
LOGGER_GROUP_ID=      # forum group that receives logs
REQUEST_CHANNEL_ID=   # where book requests are posted
SUPPORT_CHAT_ID=      # support group for appeals
INDEX_CHANNEL_ID=
BACKUP_CHAT_ID=       # private chat/channel for the pinned database backup (bot needs post + pin)
BACKUP_INTERVAL_SECONDS=300

# --- Log-group topics ---------------------------------------------------------------------
GENERAL_TOPIC_ID=1
INDEX_LOG_TOPIC_ID=0
GROUP_LOG_TOPIC_ID=0
CHANNEL_LOG_TOPIC_ID=0
USER_LOG_TOPIC_ID=0
REQUEST_LOG_TOPIC_ID=0
ERROR_LOG_TOPIC_ID=0

# --- Delivery -----------------------------------------------------------------------------
HELPER_BOT_TOKENS=    # optional, comma-separated extra bots used to deliver files
REQUIRE_HELPER_BOT_START=true
FILE_DELETE_AFTER_SECONDS=120
AUTO_DELETE_ENABLED=true

# --- Throttling, quotas, toggles ----------------------------------------------------------
MAX_INDEX_BATCH=10
INDEX_SLEEP_SECONDS=10
SEARCH_QUOTA_DEFAULT=10
REQUEST_QUOTA_DEFAULT=10
PROMOTER_QUOTA_DEFAULT=20
VOLUNTEER_QUOTA_DEFAULT=30
MODERATOR_QUOTA_DEFAULT=40
REFERRAL_BONUS_SEARCH=10
REFERRAL_BONUS_REQUEST=10
FSUB_ENABLED=false
IS_BROADCAST_ENABLED=true

# --- Ebook converter ----------------------------------------------------------------------
CONVERT_ENABLED=true
CONVERT_TIMEOUT_SECONDS=300
CONVERT_MAX_CONCURRENT=2
CONVERT_MAX_INPUT_MB=20
CONVERT_KFX_ENABLED=false   # needs Calibre's KFX Input/Output plugins installed

# --- Optional integrations ----------------------------------------------------------------
COMMUNITY_URL=        # shown on the start menu / index captions when set
GITHUB_REPO=          # owner/name, shown as the deploy target commit
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_DEPLOY_HOOK_URL=

# --- Web server ---------------------------------------------------------------------------
PORT=8080
PYTHON_VERSION=3.11.9
